@inherits InlineEdit<DateTime>

<div class="inline-editor @GetDateCssClass() @GetModeCssClass()">
    <a class="inline-editor-value d-inline-block py-1 text-nowrap @(Value == DateTime.MinValue ? "text-muted" : "")" @onclick="@(() => { if (IsEditable) DatePicker.Show(); })">
        <Icon Identifier="@Icon" />
        <span class="inline-editor-content">
            @if (Value == DateTime.MinValue)
            {
                @(PlaceHolder ?? "No value...")
            }
            else
            {
                @Value.ToString(Format ?? "yyyy-MM-dd")

                @if (ShowAge)
                {
                    <span class="ms-1 text-muted">(@GetAgeText())</span>
                }

                @if (IsTimeSelection)
                {
                    <span class="ms-1" @onclick="@(() => { if (IsEditable) TimePicker.Show(); })" @onclick:stopPropagation="true">
                        @Value.ToString(@TimeFormat)
                    </span>
                }
            }
        </span>
    </a>
</div>

<DatePicker @ref="DatePicker" Part="DatePickerPart.Day" Value="SelectedDate" ValueChanged="@(date => { SelectedDate = date; BindValue(); })" AllowClear="@AllowClear" />
<TimePicker @ref="TimePicker" Value="SelectedTime" ValueChanged="@(time => { SelectedTime = time; BindValue(); })" />